        "name": "orders_recent",
        "database": "cost-check-sample"
      },
      "query": "\n\nSELECT *\nFROM `cost-check-sample.raw.orders`\nWHERE order_date >= DATE_SUB(CURRENT_DATE(), INTERVAL 7 DAY)\n",
      "disabled": false,
      "fileName": "definitions/orders_recent.sqlx",
      "actionDescriptor": {
        "description": "Orders from the last 7 days. Creating it scans nothing; readers pay."
      },
      "dependencyTargets": [
        {
          "schema": "raw",
