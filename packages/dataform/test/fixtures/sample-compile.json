      },
      "enumType": "TABLE"
    },
    {
      "type": "incremental",
      "target": {
        "schema": "analytics",
        "name": "orders_by_customer",
        "database": "cost-check-sample"
      },
      "query": "SELECT order_date, customer_id, COUNT(*) AS orders\nFROM `cost-check-sample.raw.orders`\n\nGROUP BY order_date, customer_id",
      "disabled": false,
      "protected": false,
      "preOps": ["DECLARE checkpoint DATE DEFAULT (SELECT DATE '2000-01-01')"],
      "fileName": "definitions/orders_by_customer.js",
      "bigquery": {
        "partitionBy": "order_date"
      },
      "actionDescriptor": {
        "description": "Orders per customer per day, appended from a checkpoint."
      },
      "incrementalQuery": "SELECT order_date, customer_id, COUNT(*) AS orders\nFROM `cost-check-sample.raw.orders`\nWHERE order_date > checkpoint\nGROUP BY order_date, customer_id",
      "dependencyTargets": [
        {
          "schema": "raw",
          "name": "orders",
          "database": "cost-check-sample"
        }
      ],
      "incrementalPreOps": [
        "DECLARE checkpoint DATE DEFAULT (SELECT MAX(order_date) FROM `cost-check-sample.analytics.orders_by_customer`)"
      ],
      "hermeticity": "NON_HERMETIC",
      "canonicalTarget": {
        "schema": "analytics",
        "name": "orders_by_customer",
        "database": "cost-check-sample"
      },
      "enumType": "INCREMENTAL",
      "onSchemaChange": "IGNORE",
      "incrementalStrategy": "INCREMENTAL_STRATEGY_UNSPECIFIED"
    },
    {
      "type": "incremental",
      "target": {
        "schema": "analytics",
        "name": "orders_daily",
        "database": "cost-check-sample"
      },
      "query": "\n\nSELECT\n  order_date,\n  COUNT(*) AS orders,\n  SUM(amount) AS revenue\nFROM `cost-check-sample.raw.orders`\n\nGROUP BY order_date\n",
      "disabled": false,
      "protected": false,
      "fileName": "definitions/orders_daily.sqlx",
      "bigquery": {
        "partitionBy": "order_date"
      },
      "tags": ["hourly"],
      "actionDescriptor": {
        "description": "Daily order totals. The incremental query reads only new partitions."
      },
      "incrementalQuery": "\n\nSELECT\n  order_date,\n  COUNT(*) AS orders,\n  SUM(amount) AS revenue\nFROM `cost-check-sample.raw.orders`\nWHERE order_date >= (SELECT MAX(order_date) FROM `cost-check-sample.analytics.orders_daily`)\nGROUP BY order_date\n",
      "dependencyTargets": [
        {
          "schema": "raw",
          "name": "orders",
          "database": "cost-check-sample"
        }
      ],
      "uniqueKey": ["order_date"],
      "hermeticity": "NON_HERMETIC",
      "canonicalTarget": {
        "schema": "analytics",
        "name": "orders_daily",
        "database": "cost-check-sample"
      },
      "enumType": "INCREMENTAL",
      "onSchemaChange": "IGNORE",
      "incrementalStrategy": "INCREMENTAL_STRATEGY_UNSPECIFIED"
    },
    {
      "type": "view",
